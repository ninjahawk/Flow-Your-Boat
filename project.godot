; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flow Sorter"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
Palette="*res://scripts/autoload/Palette.gd"
Effects="*res://scripts/autoload/Effects.gd"
SaveData="*res://scripts/SaveData.gd"
DebugCapture="*res://scripts/autoload/DebugCapture.gd"
TestPlayer="*res://scripts/autoload/TestPlayer.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/resizable=false
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
environment/default_clear_color=Color(0.051, 0.059, 0.102, 1)
